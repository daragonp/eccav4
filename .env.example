APP_NAME="Emancipación Cristiana Colombiana Afro"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=your_database
DB_USERNAME=your_username
DB_PASSWORD=your_password

APP_KEY=base64:YOUR_APP_KEY

# Rendimiento: cache, sesión y cola sobre Redis.
# Redis está disponible vía Docker (REDIS_HOST=laravel_redis en compose/producción, puerto 6379).
# config/cache.php lee CACHE_DRIVER; en Laravel 11+ el nombre canónico es CACHE_STORE,
# por lo que en el .env real conviene definir TAMBIÉN CACHE_STORE=redis.
# QUEUE_CONNECTION=redis requiere un worker permanente: `php artisan queue:work`
# (sin worker, los jobs de audio IA y de geolocalización NO se ejecutarán).
CACHE_DRIVER=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
SESSION_DOMAIN=
SESSION_COOKIE=emancipacion_cristiana_afro_session

# En Docker/producción usar el nombre del servicio: REDIS_HOST=laravel_redis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=465
MAIL_USERNAME=noreply@example.com
MAIL_PASSWORD=your_mail_password
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME="Emancipación Cristiana Afro"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PAYU_API_KEY=
PAYU_MERCHANT_ID=
PAY_U_MARKET=
PAY_U_ACC_ID=
PAYU_BASE_URL=https://sandbox.checkout.payulatam.com/ppp-web-gateway-payu/

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

CORS_ALLOWED_ORIGINS="https://www.tezbrillante.org,https://tezbrillante.org,https://www.emancipacioncristianaafro.org,https://emancipacioncristianaafro.org,http://127.0.0.1:8000"
CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=*
CORS_SUPPORTS_CREDENTIALS=true

# WideStream Radio Server
RADIO_STREAM_URL=https://widestream.app/radio.aac
RADIO_STREAM_HLS_URL=https://widestream.app/hls/live.m3u8
RADIO_STREAM_EMBED_URL=https://widestream.app/embed/main
RADIO_STATION_URL=https://widestream.app/

# Docker (compose)
# Credenciales de MySQL consumidas por docker-compose.yml y docker-compose.production.yml
# (laravel_db, su healthcheck y el servicio backup) mediante ${VAR:-fallback}.
# En producción DEBEN definirse valores reales y hay que ROTAR las contraseñas por defecto.
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=eccav4
MYSQL_USER=
MYSQL_PASSWORD=

